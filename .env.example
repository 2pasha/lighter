# ==============================================================================
# Svitlo Bot (Вінницяобленерго — Графіки відключень світла)
# ==============================================================================

# 1. Telegram Bot Token (від @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# 2. База даних (Supabase REST API, PostgreSQL URI або локальний SQLite)
SUPABASE_URL=https://wgegdxblmurnywmuzxbz.supabase.co
SUPABASE_KEY=your_supabase_api_key
DATABASE_URL=
DATABASE_PATH=data/svitlo_bot.db
TIMEZONE=Europe/Kyiv

# 3. Інтервал перевірки графіків (у хвилинах)
POLL_INTERVAL_MINUTES=5

# 4. Джерела даних (Вінницяобленерго)
VOE_BASE_URL=https://www.voe.com.ua
VOE_GITHUB_JSON_URL=https://raw.githubusercontent.com/vn-progr/gpv-voe-vinnytsia/main/data/Vinnytsiaoblenerho.json

# 5. (Опціонально) Fallback через офіційний бот @pat_voe_bot (Telethon MTProto)
# Отримати API_ID та API_HASH можна на https://my.telegram.org
TELETHON_ENABLED=false
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION_STRING=
OFFICIAL_VOE_BOT_USERNAME=pat_voe_bot

# 6. Порт для Healthcheck сервера (для Render / Railway / Fly.io)
PORT=8080
